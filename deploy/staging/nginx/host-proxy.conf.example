# Owner-managed host nginx template for the approved staging layout.
# Keep the existing production site configs unchanged. Install this file as a
# separate sites-enabled entry only after reviewing the four test host names.

server {
    listen 80;
    server_name test-api.drlifeplus.com test-miniapp.drlifeplus.com
                test-shop.drlifeplus.com test-admin.drlifeplus.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name test-api.drlifeplus.com test-miniapp.drlifeplus.com
                test-shop.drlifeplus.com test-admin.drlifeplus.com;

    ssl_certificate /srv/drlifeplus-staging/certs/cloudflare-origin.crt;
    ssl_certificate_key /srv/drlifeplus-staging/certs/cloudflare-origin.key;

    location / {
        proxy_pass https://127.0.0.1:18443;
        proxy_ssl_server_name on;
        proxy_ssl_name $host;
        # The inner hop is loopback; the edge still terminates TLS and applies
        # the staging security/rate-limit policy for the original Host.
        proxy_ssl_verify off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }
}
