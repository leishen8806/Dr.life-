# Generated on the staging server by harden-server.sh. This repository copy is
# only a placeholder; these RFC 5737/RFC 3849 networks must be replaced before
# startup. Never sync this file over the server-generated real-ip config.
real_ip_header CF-Connecting-IP;
real_ip_recursive on;
set_real_ip_from 198.51.100.0/24;
set_real_ip_from 2001:db8::/32;
