# Copy to .env locally; never commit .env. Values are placeholders only.
APP_ENV=staging
# E-09 smoke checks: set these only when running deploy/staging/smoke.sh.
# SMOKE_API_BASE_URL=
# SMOKE_BUYER_URL=
# SMOKE_MERCHANT_URL=
# SMOKE_SHOP_URL=
# Build-time only; pass this to each Vite frontend build. It is not a runtime secret.
VITE_API_BASE_URL=https://test-api.drlifeplus.com
APP_RELEASE=placeholder-release
# The compose file defaults to this path; keep it as .env in the staging directory.
STAGING_ENV_FILE=.env
STAGING_CLOUDFLARE_REAL_IP_CONFIG=/srv/drlifeplus-staging/nginx/cloudflare-real-ip.conf
STAGING_DOCKER_NETWORK=drlife-staging_default
# Optional: harden-server.sh derives this single gateway CIDR from Docker.
# STAGING_EDGE_TRUST_CIDR=<docker-gateway-cidr>
STAGING_SITE_ROOT=/srv/drlifeplus-staging
STAGING_ORIGIN_CERT_PATH=/srv/drlifeplus-staging/certs/cloudflare-origin.crt
STAGING_ORIGIN_KEY_PATH=/srv/drlifeplus-staging/certs/cloudflare-origin.key
POSTGRES_DB=drlife_staging
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_FROM_OWNER_SECRET_STORE
DATABASE_URL=postgres://app_ops:CHANGE_ME@postgres:5432/drlife_staging?sslmode=disable
WORKER_DATABASE_URL=postgres://app_ledger:CHANGE_ME@postgres:5432/drlife_staging?sslmode=disable
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/drlife_staging?sslmode=disable
REPORT_DATABASE_URL=postgres://app_report:CHANGE_ME@postgres:5432/drlife_staging?sslmode=disable
AUDIT_DATABASE_URL=postgres://app_audit:CHANGE_ME@postgres:5432/drlife_staging?sslmode=disable
IAM_DATABASE_URL=postgres://app_iam:CHANGE_ME@postgres:5432/drlife_staging?sslmode=disable
REDIS_STATE_PASSWORD=CHANGE_ME_OWNER_REDIS_STATE_PASSWORD
REDIS_QUEUE_PASSWORD=CHANGE_ME_OWNER_REDIS_QUEUE_PASSWORD
REDIS_CACHE_PASSWORD=CHANGE_ME_OWNER_REDIS_CACHE_PASSWORD
REDIS_URL=redis://:CHANGE_ME_OWNER_REDIS_STATE_PASSWORD@redis-state:6379/0
QUEUE_REDIS_URL=redis://:CHANGE_ME_OWNER_REDIS_QUEUE_PASSWORD@redis-queue:6379/0
CACHE_REDIS_URL=redis://:CHANGE_ME_OWNER_REDIS_CACHE_PASSWORD@redis-cache:6379/0
JWT_SIGNING_KEYS=CHANGE_ME_OWNER_MANAGED_KEY
JWT_ACTIVE_KEY_ID=staging-key-1
MASTER_KEY_SHARE_A=CHANGE_ME_OWNER_SECRET_SHARE_A
MASTER_KEY_SHARE_B=CHANGE_ME_OWNER_SECRET_SHARE_B
# Must match one key ID represented by the owner-managed master key shares.
ACTIVE_MASTER_KEY_ID=staging-key-1
OPS_ALERT_BOT_TOKEN=CHANGE_ME_OWNER_TELEGRAM_TOKEN
CORS_BUYER_ORIGINS=https://test-miniapp.drlifeplus.com
CORS_MERCHANT_ORIGINS=https://test-shop.drlifeplus.com
CORS_ADMIN_ORIGINS=https://test-admin.drlifeplus.com
CORS_PUBLIC_ORIGINS=https://test-api.drlifeplus.com
# Admin uses cross-origin requests to the API. Keep this exact path credentialed
# so the host-only Secure/SameSite=Strict refresh cookie can rotate.
CORS_CREDENTIAL_PATHS=/v1/admin/auth/refresh
IAM_DB_PASSWORD=CHANGE_ME
CATALOG_DB_PASSWORD=CHANGE_ME
TRADE_DB_PASSWORD=CHANGE_ME
WMS_DB_PASSWORD=CHANGE_ME
LOGISTICS_DB_PASSWORD=CHANGE_ME
LEDGER_DB_PASSWORD=CHANGE_ME
COMMS_DB_PASSWORD=CHANGE_ME
AI_DB_PASSWORD=CHANGE_ME
OPS_DB_PASSWORD=CHANGE_ME
FILE_WORKER_DB_PASSWORD=CHANGE_ME
AUDIT_DB_PASSWORD=CHANGE_ME
REPORT_DB_PASSWORD=CHANGE_ME
