// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`foundation components > renders the reusable shell with accessible navigation and snapshots 1`] = `
[
  <header
    className="drl-app-header"
  >
    <div>
      <strong
        className="drl-app-header__brand"
      >
        Dr.life+
      </strong>
      <p
        className="drl-app-header__slogan"
      >
        INFINITE POSSIBILITIES
      </p>
    </div>
    <div
      className="drl-app-header__actions"
    >
      <button
        aria-label="AI"
      >
        AI
      </button>
    </div>
  </header>,
  <section
    className="drl-card"
  >
    <div
      className="drl-list-item"
    >
      <React.Fragment>
        <span
          className="drl-list-item__content"
        >
          <strong>
            Order
          </strong>
          <small>
            Ready
          </small>
        </span>
        <span
          className="drl-list-item__trailing"
        >
          1
        </span>
      </React.Fragment>
    </div>
  </section>,
  <ol
    className="drl-stepper"
  >
    <li
      className="is-complete"
    >
      Created
    </li>
    <li
      aria-current="step"
      className="is-complete"
    >
      Shipped
    </li>
    <li>
      Delivered
    </li>
  </ol>,
  <span
    className="drl-status-tag drl-status-tag--success"
  >
    Ready
  </span>,
  <nav
    aria-label="Primary navigation"
    className="drl-bottom-navigation"
  >
    <button
      aria-current="page"
      className="drl-bottom-navigation__item"
      onClick={[Function]}
      type="button"
    >
      <span
        aria-hidden="true"
        className="drl-bottom-navigation__icon"
      >
        ⌂
      </span>
      <span>
        Home
      </span>
    </button>
    <button
      className="drl-bottom-navigation__item"
      onClick={[Function]}
      type="button"
    >
      <span
        aria-hidden="true"
        className="drl-bottom-navigation__icon"
      >
        ●
      </span>
      <span>
        Me
      </span>
      <span
        className="drl-bottom-navigation__badge"
      >
        2
      </span>
    </button>
  </nav>,
]
`;
