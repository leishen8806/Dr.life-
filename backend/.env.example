# The service reads environment variables directly; copy this file to backend/.env for local development.
# Makefile db-* targets load backend/.env; load it into your shell before running make run.
HTTP_ADDR=:8080
# Internal-only Prometheus listener. Set an explicitly empty value to disable it.
METRICS_ADDR=127.0.0.1:9100
APP_ENV=dev
APP_RELEASE=dev
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=15
READ_HEADER_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=30
IDLE_TIMEOUT_SECONDS=60
# Initial values pending S-05 load-test calibration. critical reserves 25% of BULKHEAD_TOTAL; stream is outside BULKHEAD_TOTAL.
BULKHEAD_TOTAL=512
BULKHEAD_WAIT_MS=100
BULKHEAD_DRAIN_SECONDS=5
BULKHEAD_CRITICAL_LIMIT=512
BULKHEAD_AUTH_LIMIT=64
BULKHEAD_WRITE_LIMIT=128
BULKHEAD_READ_LIMIT=256
BULKHEAD_HEAVY_LIMIT=32
BULKHEAD_STREAM_LIMIT=256
# Comma-separated route prefixes; only a trailing * is accepted as a wildcard.
BULKHEAD_CRITICAL_PREFIXES=/v1/buyer/withdraw*,/v1/merchant/withdraw*,/v1/driver/withdraw*,/v1/ledger,/v1/admin/finance
# Comma-separated /path-prefix=critical|auth|write|read|heavy|health overrides.
BULKHEAD_ROUTE_CLASSES=
# Comma-separated /v1/{buyer|merchant|driver|wms|admin}/events SSE prefixes; empty by default.
BULKHEAD_DEADLINE_EXEMPT_PATHS=

# Adaptive brownout. Escalation halves the heavy limit per level, never below 1
# (with BULKHEAD_HEAVY_LIMIT=32 and three levels the effective floor is 4);
# recovery requires a sustained window below every recovery threshold.
# Initial values pending S-05 load-test calibration.
BROWNOUT_ESCALATE_AFTER_SECONDS=5
BROWNOUT_RECOVER_AFTER_SECONDS=60
BROWNOUT_P95_THRESHOLD_MS=2000
BROWNOUT_P95_RECOVERY_MS=1000
BROWNOUT_DB_WAIT_THRESHOLD_MS=100
BROWNOUT_DB_WAIT_RECOVERY_MS=50
BROWNOUT_INFLIGHT_RATIO_PERCENT=80
BROWNOUT_INFLIGHT_RECOVERY_PERCENT=60
BROWNOUT_SAMPLE_INTERVAL_MS=1000

# Development infrastructure. Copy this file to backend/.env and replace CHANGE_ME locally.
POSTGRES_DB=drlife
POSTGRES_USER=drlife_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
QUEUE_REDIS_HOST_PORT=56380

MIGRATION_DATABASE_URL=postgres://drlife_admin:CHANGE_ME@127.0.0.1:55432/drlife?sslmode=disable
# cmd/server runs as app_catalog: make db-bootstrap grants catalog_rw plus the narrow iam reads it needs.
DATABASE_URL=postgres://app_catalog:CHANGE_ME@127.0.0.1:55432/drlife?sslmode=disable
IAM_DATABASE_URL=postgres://app_iam:CHANGE_ME@127.0.0.1:55432/drlife?sslmode=disable
AUDIT_DATABASE_URL=postgres://app_audit:CHANGE_ME@127.0.0.1:55432/drlife?sslmode=disable
REPORT_DATABASE_URL=postgres://app_report:CHANGE_ME@127.0.0.1:55432/drlife?sslmode=disable
REDIS_URL=redis://127.0.0.1:56379/0
# Queue Redis must use noeviction and AOF everysec. Never point this at REDIS_URL.
QUEUE_REDIS_URL=redis://127.0.0.1:56380/0
# Development-only escape hatch for disposable local Redis; production must remain false.
QUEUE_ALLOW_EVICTION=false
DB_MAX_CONNS=10
# `DB_MAX_CONNS` is the oltp pool. Keep all three pools on one application server
# within 40% of PostgreSQL max_connections; see internal/platform/db/README.md.
REPORT_DB_MAX_CONNS=4
WORKER_DB_MAX_CONNS=4
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT_SECONDS=5
DB_ACQUIRE_TIMEOUT_MILLISECONDS=100
DB_SLOW_QUERY_MS=200
# Empty disables Sentry completely.
SENTRY_DSN=

# CORS is isolated by client path. APP_ENV=dev adds http://localhost:5173 automatically.
CORS_BUYER_ORIGINS=https://miniapp.settlecore.org
CORS_MERCHANT_ORIGINS=https://shop.settlecore.org
CORS_DRIVER_ORIGINS=https://driver.settlecore.org
CORS_WMS_ORIGINS=https://wms.settlecore.org
CORS_ADMIN_ORIGINS=https://admin.settlecore.org
CORS_PUBLIC_ORIGINS=https://miniapp.settlecore.org,https://shop.settlecore.org,https://driver.settlecore.org,https://wms.settlecore.org,https://admin.settlecore.org,https://settlecore.org
# Explicit refresh endpoints allowed to send cookies; empty until A-03/A-06 add them.
CORS_CREDENTIAL_PATHS=
# Empty by default. A future Telegram webhook may set a dedicated non-v1 prefix and must enforce its own authentication.
PUBLIC_WEBHOOK_PREFIX=
WEBHOOK_MAX_BODY_BYTES=65536
# Trust the forwarding header only from these direct proxy networks; replace the example CIDRs in production.
TRUSTED_PROXY_HEADER=CF-Connecting-IP
TRUSTED_PROXY_CIDRS=192.0.2.0/24,2001:db8::/32
# Empty denies admin and WMS traffic outside dev.
ADMIN_ALLOWED_CIDRS=
REQUEST_BODY_MAX_BYTES=65536
# Optional exact route limits use /path=bytes entries; explicit multipart/webhook prefixes bypass JSON enforcement.
REQUEST_BODY_OVERRIDES=
CONTENT_TYPE_EXEMPT_PATHS=
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_MAX_RESPONSE_BYTES=65536
# Temporary path contract; update when financial routes are finalized.
IDEMPOTENCY_FINANCIAL_PREFIXES=/v1/buyer/withdraw,/v1/buyer/withdrawals,/v1/ledger,/v1/admin/finance
# Shared mobile carrier NAT can put many Cambodian users behind one public IP, so the unauthenticated IP default is intentionally higher.
# Fixed one-minute windows. Login, withdrawal, and AI path segments use the stricter thresholds below.
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_ACCOUNT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_WITHDRAW_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_ADMIN_PER_MINUTE=60

# Telegram Mini App login. Generate independent 32-byte base64 values; never commit real keys.
TELEGRAM_INITDATA_MAX_AGE=24h
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_TOKEN_GRACE=10s
SESSION_IDLE_TTL=24h
SESSION_MAX_PER_ACCOUNT=5
TOKEN_ISSUER=drlife
# Default closed. During deployment only, set an RFC3339 instant no more than 15 minutes ahead to accept A-02 tokens without typ/aud/iss.
TOKEN_LEGACY_ACCEPT_UNTIL=
LOGIN_FAILURE_LIMIT=20
LOGIN_FAILURE_WINDOW=10m
BOT_TOKEN_CACHE_TTL=5m
JWT_SIGNING_KEYS=old:CHANGE_ME_BASE64_32_BYTES,current:CHANGE_ME_BASE64_32_BYTES
JWT_ACTIVE_KEY_ID=current
# Bot tokens use the F-10 envelope keyring. Replace with real 32-byte base64 keys outside Git.
MASTER_KEYS=current:CHANGE_ME_BASE64_32_BYTES
ACTIVE_MASTER_KEY_ID=current

# Daily ledger snapshots use this IANA timezone boundary.
LEDGER_RECON_TIMEZONE=Asia/Phnom_Penh

# Object storage: credentials are placeholders only; do not log pre-signed URLs or credentials.
STORAGE_DRIVER=s3
STORAGE_BUCKET=CHANGE_ME
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,application/pdf
STORAGE_MAX_CONTENT_LENGTH=10485760
# Leave empty to keep CDN prefixing disabled. Malware ScanHook is disabled until a provider is wired.
STORAGE_CDN_PREFIX=
STORAGE_SCAN_HOOK_ENABLED=false

IAM_DB_PASSWORD=CHANGE_ME
CATALOG_DB_PASSWORD=CHANGE_ME
TRADE_DB_PASSWORD=CHANGE_ME
WMS_DB_PASSWORD=CHANGE_ME
LOGISTICS_DB_PASSWORD=CHANGE_ME
LEDGER_DB_PASSWORD=CHANGE_ME
COMMS_DB_PASSWORD=CHANGE_ME
AI_DB_PASSWORD=CHANGE_ME
OPS_DB_PASSWORD=CHANGE_ME
AUDIT_DB_PASSWORD=CHANGE_ME
REPORT_DB_PASSWORD=CHANGE_ME
