# Copy values into the deployment secret injector. Do not rename this file to a tracked plaintext environment file.
MASTER_KEYS=key-previous:<BASE64_32_BYTE_KEY>,key-active:<BASE64_32_BYTE_KEY>
ACTIVE_MASTER_KEY_ID=key-active

# Alternative 2-of-2 startup mode. Inject each share from a separate administrator-controlled source.
MASTER_KEY_SHARE_A=<BASE64_SHARE_A>
MASTER_KEY_SHARE_B=<BASE64_SHARE_B>
