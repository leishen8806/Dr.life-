---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Layout from "./Layout.astro";
import Localizer from "./Localizer.astro";
import { locales } from "../i18n";
const { type } = Astro.props;
const copy = locales.zh;
const isPrivacy = type === "privacy";
const titleKey = isPrivacy ? "legal.privacy" : "legal.terms";
const intro = isPrivacy ? copy.legal.privacyIntro : copy.legal.termsIntro;
const sections = isPrivacy ? copy.legal.privacySections : copy.legal.termsSections;
---
<Layout titleKey={titleKey} descriptionKey={isPrivacy ? "legal.privacyIntro" : "legal.termsIntro"}><Header /><main class="legal-page"><nav class="legal-nav" aria-label="Legal documents"><a class="legal-current" href="/privacy" data-i18n="legal.privacy">{copy.legal.privacy}</a><a href="/terms" data-i18n="legal.terms">{copy.legal.terms}</a><a href="/delete-account" data-i18n="legal.delete">{copy.legal.delete}</a><a href="/contact" data-i18n="legal.contact">{copy.legal.contact}</a></nav><p class="draft" data-i18n="legal.draft">{copy.legal.draft}</p><h1 data-i18n={titleKey}>{isPrivacy ? copy.legal.privacy : copy.legal.terms}</h1><div class="legal-meta"><span data-i18n="legal.version">{copy.legal.version}</span><span data-i18n="legal.effective">{copy.legal.effective}</span><a href="#history" data-i18n="legal.history">{copy.legal.history}</a></div><p class="legal-note" data-i18n={isPrivacy ? "legal.privacyIntro" : "legal.termsIntro"}>{intro}</p><div class="legal-layout"><nav class="legal-toc" aria-label="Table of contents">{sections.map(([title], index) => <a href={`#section-${index + 1}`}>{index + 1}. {title}</a>)}</nav><article class="legal-content">{sections.map(([title, body], index) => <section id={`section-${index + 1}`}><h2>{index + 1}. {title}</h2><p>{body}</p></section>)}<section class="legal-history" id="history"><h2 data-i18n="legal.history">{copy.legal.history}</h2><p data-i18n="legal.historyCurrent">{copy.legal.historyCurrent}</p></section></article></div></main><Footer /><Localizer /></Layout>
