---
import { locales, read } from "../i18n";
import BrandWordmark from "./BrandWordmark.astro";
const copy = locales.zh;
---
<footer class="site-footer">
  <div><BrandWordmark class="brand" href="/" /><p data-i18n="brand.tagline">{read(copy, "brand.tagline")}</p><p class="khmer" data-i18n="brand.welcome">{read(copy, "brand.welcome")}</p></div>
  <nav class="footer-links footer-links--home" aria-label={read(copy, "nav.about")}><a href="/#business" data-i18n="nav.vision">{read(copy, "nav.vision")}</a><a href="/#market" data-i18n="nav.ecosystem">{read(copy, "nav.ecosystem")}</a><a href="/#route" data-i18n="nav.service">{read(copy, "nav.service")}</a><a href="/#about" data-i18n="nav.about">{read(copy, "nav.about")}</a><a href="/#apps" data-i18n="nav.shop">{read(copy, "nav.shop")}</a></nav>
  <div class="footer-links"><a href="/privacy" data-i18n="legal.privacy">{read(copy, "legal.privacy")}</a><a href="/terms" data-i18n="legal.terms">{read(copy, "legal.terms")}</a><a href="/delete-account" data-i18n="legal.delete">{read(copy, "legal.delete")}</a><a href="/contact" data-i18n="legal.contact">{read(copy, "legal.contact")}</a></div>
  <p class="official" data-i18n="brand.official">{read(copy, "brand.official")}</p>
  <p data-i18n="footer.copyright">{read(copy, "footer.copyright")}</p>
</footer>
