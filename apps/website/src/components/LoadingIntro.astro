---
import BrandWordmark from "./BrandWordmark.astro";
---
<template id="site-loading-template">
  <div class="site-loader" aria-hidden="true">
    <div class="site-loader__mark">
      <BrandWordmark class="site-loader__brand" />
      <div class="site-loader__track"><span></span></div>
    </div>
  </div>
</template>

<script>
  import { initLoadingIntro } from "../scripts/loading-intro.mjs";

  initLoadingIntro(window, document);
</script>

<style>
  .site-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 50% 42%, var(--graphite), var(--deep) 68%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .site-loader.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .site-loader.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  .site-loader__mark {
    display: grid;
    justify-items: center;
    gap: 22px;
    transform: translateY(-2vh);
  }

  :global(.site-loader__brand) {
    color: var(--ivory);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
  }

  .site-loader__track {
    width: min(220px, 58vw);
    height: 2px;
    overflow: hidden;
    background: rgb(199 203 207 / 22%);
  }

  .site-loader__track span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    animation: site-loader-progress 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes site-loader-progress {
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-loader { display: none; }
  }
</style>
