---
import Footer from "../../components/Footer.astro"; import Header from "../../components/Header.astro"; import Layout from "../../components/Layout.astro"; import Localizer from "../../components/Localizer.astro"; import { locales, type Locale } from "../../i18n";
export function getStaticPaths() { return ["en", "km"].map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Locale }; const copy = locales[lang];
---
<Layout titleKey="notFound.title" descriptionKey="notFound.intro" robots="noindex" lang={lang}><Header lang={lang} /><main class="not-found-page"><p class="eyebrow">404</p><h1>{copy.notFound.title}</h1><p>{copy.notFound.intro}</p><nav class="button-row"><a class="button button--gold" href={`/${lang}/`}>{copy.notFound.home}</a><a class="button button--dark" href={`/${lang}/merchant/`}>{copy.notFound.merchant}</a><a class="button" href={`/${lang}/contact/`}>{copy.notFound.contact}</a></nav></main><Footer lang={lang} /></Layout>
