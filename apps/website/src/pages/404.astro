---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import Localizer from "../components/Localizer.astro";
import { locales } from "../i18n";

const copy = locales.zh;
---
<Layout titleKey="notFound.title" descriptionKey="notFound.intro" robots="noindex">
  <Header />
  <main class="not-found-page">
    <p class="eyebrow">404</p>
    <h1 data-i18n="notFound.title">{copy.notFound.title}</h1>
    <p data-i18n="notFound.intro">{copy.notFound.intro}</p>
    <p class="not-found-page__draft" data-i18n="notFound.draft" hidden></p>
    <nav class="button-row">
      <a class="button button--gold" href="/" data-i18n="notFound.home">{copy.notFound.home}</a>
      <a class="button button--dark" href="/merchant" data-i18n="notFound.merchant">{copy.notFound.merchant}</a>
      <a class="button" href="/contact" data-i18n="notFound.contact">{copy.notFound.contact}</a>
    </nav>
  </main>
  <Footer />
  <Localizer />
</Layout>
