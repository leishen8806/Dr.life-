---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import Localizer from "../components/Localizer.astro";
import { locales } from "../i18n";

const copy = locales.zh;
const categories = copy.home.categories;
const categoryImages = ["category-tiles", "category-bathroom", "category-doors", "category-furniture", "category-paint"];
const ecosystem = copy.home.ecosystemNodes;
const chain = copy.home.chain.map((title, index) => [title, copy.home.chainBodies[index]] as const);
const partners = copy.home.partners;
// Homepage v2 keeps the source.html information architecture: business, market,
// route, culture, apps and partners. Financial services are explicitly not open.
// home.ecoTitleLines remains a legacy locale key for compatibility; visible copy uses dedicated about keys.
---
<Layout titleKey="home.title" descriptionKey="home.intro">
  <a class="skip" href="#main" data-i18n="nav.about">{copy.nav.about}</a>
  <Header dark />
  <main id="main">
    <section class="hero hero--v2" id="top" aria-labelledby="home-title">
      <div class="hero-arc hero-arc--outer" aria-hidden="true"></div><div class="hero-arc hero-arc--gold" aria-hidden="true"></div><div class="hero-disc" aria-hidden="true"></div>
      <div class="hero-inner container"><div class="hero-content">
        <p class="eyebrow" data-i18n="home.eyebrow">{copy.home.eyebrow}</p>
        <h1 id="home-title" data-i18n="home.title"><span>{copy.home.title}</span></h1>
        <p class="hero-en" data-i18n="home.subtitle">{copy.home.subtitle}</p>
        <p class="hero-position" data-i18n="home.intro">{copy.home.intro}</p>
        <div class="hero-stats">{copy.home.stats.map(([value, label], index) => <div class="stat"><strong>{value}</strong><span data-i18n={`home.stats.${index}.1`}>{label}</span></div>)}</div>
        <div class="actions"><a class="button gold" href="/merchant" data-i18n="home.primary">{copy.home.primary}<span class="arrow" aria-hidden="true">↗</span></a><a class="button ghost" href="#business" data-i18n="home.secondary">{copy.home.secondary}<span class="arrow" aria-hidden="true">↓</span></a></div>
      </div></div>
    </section>
    <nav class="hero-index" aria-label={copy.nav.about}><div class="container">
      <a href="#business"><b>01</b><span data-i18n="nav.vision">{copy.nav.vision}</span><span class="arrow" aria-hidden="true">↘</span></a>
      <a href="#market"><b>02</b><span data-i18n="nav.ecosystem">{copy.nav.ecosystem}</span><span class="arrow" aria-hidden="true">↘</span></a>
      <a href="#route"><b>03</b><span data-i18n="nav.service">{copy.nav.service}</span><span class="arrow" aria-hidden="true">↘</span></a>
      <a href="#apps"><b>04</b><span data-i18n="nav.shop">{copy.nav.shop}</span><span class="arrow" aria-hidden="true">↘</span></a>
    </div></nav>

    <section class="section" id="business" aria-labelledby="business-title"><div class="container">
      <div class="split-intro"><div><p class="eyebrow" data-i18n="home.visionLabel">{copy.home.visionLabel}</p><h2 id="business-title" class="section-title"><span data-i18n="home.visionTitleLines.0">{copy.home.visionTitleLines[0]}</span><br /><span data-i18n="home.visionTitleLines.1">{copy.home.visionTitleLines[1]}</span></h2></div><p class="lead" data-i18n="home.visionIntro">{copy.home.visionIntro}</p></div>
      <div class="business-grid">{ecosystem.slice(0, 4).map(([title, body, state], index) => <article class="panel business-panel ecosystem-node"><div class="panel-copy"><p class="eyebrow"><span>{String(index + 1).padStart(2, "0")}</span><span data-i18n={state === "open" ? "home.open" : "home.planned"}>{state === "open" ? copy.home.open : copy.home.planned}</span></p><h3 data-i18n={`home.ecosystemNodes.${index}.0`}>{title}</h3><p data-i18n={`home.ecosystemNodes.${index}.1`}>{body}</p><a class="text-link" href={index === 0 ? "#market" : "#route"} data-i18n="home.categoriesCta">{copy.home.categoriesCta}<span class="arrow" aria-hidden="true">↗</span></a></div></article>)}</div>
      <ol class="stages stages--compact">{copy.home.stages.map(([number, status, title, body], index) => <li class="stage"><div><strong>{number}</strong><span data-i18n={`home.stages.${index}.1`}>{status}</span></div><h3 data-i18n={`home.stages.${index}.2`}>{title}</h3><p data-i18n={`home.stages.${index}.3`}>{body}</p></li>)}</ol>
    </div></section>

    <section class="market section" id="market" aria-labelledby="market-title"><div class="container"><div class="split-intro"><div><p class="eyebrow" data-i18n="home.categoriesLabel">{copy.home.categoriesLabel}</p><h2 id="market-title" class="section-title" data-i18n="home.categoriesTitle">{copy.home.categoriesTitle}</h2></div><a class="lead text-link" href="#apps" data-i18n="home.categoriesCta">{copy.home.categoriesCta}</a></div><div class="category-grid">{categories.map(([english, title, note], index) => <article class={`category-card category-card--${index}`}><picture><source type="image/avif" srcset={`/images/${categoryImages[index]}-640.avif 640w, /images/${categoryImages[index]}-1280.avif 1280w`} /><source type="image/webp" srcset={`/images/${categoryImages[index]}-640.webp 640w, /images/${categoryImages[index]}-1280.webp 1280w`} /><img src={`/images/${categoryImages[index]}-640.webp`} srcset={`/images/${categoryImages[index]}-640.webp 640w, /images/${categoryImages[index]}-1280.webp 1280w`} sizes="(max-width: 720px) 100vw, 50vw" loading="lazy" decoding="async" data-i18n-alt={`home.categoryAlts.${index}`} alt={copy.home.categoryAlts[index]} /></picture><span data-i18n={`home.categories.${index}.0`}>{english}</span><h3 data-i18n={`home.categories.${index}.1`}>{title}</h3><small data-i18n={`home.categories.${index}.2`}>{note}</small></article>)}</div></div></section>

    <section class="section dark route" id="route" aria-labelledby="route-title"><div class="container"><div class="split-intro"><div><p class="eyebrow" data-i18n="home.chainLabel">{copy.home.chainLabel}</p><h2 id="route-title" class="section-title"><span data-i18n="home.chainTitleLines.0">{copy.home.chainTitleLines[0]}</span><br /><span data-i18n="home.chainTitleLines.1">{copy.home.chainTitleLines[1]}</span></h2></div><p class="lead" data-i18n="home.chainIntro">{copy.home.chainIntro}</p></div><ol class="steps">{chain.slice(0, 4).map(([title, body], index) => <li class="chain-step"><span>{String(index + 1).padStart(2, "0")}</span><h3 data-i18n={`home.chain.${index}`}>{title}</h3><p data-i18n={`home.chainBodies.${index}`}>{body}</p></li>)}</ol><p class="route-note" data-i18n="home.chainNote">{copy.home.chainNote}</p></div></section>

    <section class="section" id="about"><div id="culture" class="container culture" aria-labelledby="culture-title"><div class="intro"><p class="eyebrow" data-i18n="home.aboutLabel">{copy.home.aboutLabel}</p><h2 id="culture-title" class="section-title"><span data-i18n="home.aboutTitleLines.0">{copy.home.aboutTitleLines[0]}</span><br /><span data-i18n="home.aboutTitleLines.1">{copy.home.aboutTitleLines[1]}</span></h2><p class="lead" data-i18n="home.aboutIntro">{copy.home.aboutIntro}</p></div><div class="values">{copy.home.aboutValues.map(([label, title, body], index) => <article><span data-i18n={`home.aboutValues.${index}.0`}>{label}</span><h3 data-i18n={`home.aboutValues.${index}.1`}>{title}</h3><p data-i18n={`home.aboutValues.${index}.2`}>{body}</p></article>)}</div></div></section>

    <section class="section partners" id="partners" aria-labelledby="partners-title"><div class="container"><div class="intro"><p class="eyebrow" data-i18n="home.partnersLabel">{copy.home.partnersLabel}</p><h2 id="partners-title" class="section-title" data-i18n="home.partnersTitle">{copy.home.partnersTitle}</h2></div><div class="partner-grid">{partners.map(([label, title, body], index) => <article class="partner"><small data-i18n={`home.partners.${index}.0`}>{label}</small><h3 data-i18n={`home.partners.${index}.1`}>{title}</h3><p data-i18n={`home.partners.${index}.2`}>{body}</p><a class="text-link" href={index === 0 ? "/merchant" : "/contact"} data-i18n={`home.partnerCtas.${index}`}>{copy.home.partnerCtas[index]}<span class="arrow" aria-hidden="true">↗</span></a></article>)}</div></div></section>

    <section class="section dark access-section" id="apps" aria-labelledby="access-title"><div class="container"><div class="split-intro"><div><p class="eyebrow" data-i18n="home.appsLabel">{copy.home.appsLabel}</p><h2 id="access-title" class="section-title" data-i18n="home.appsTitle">{copy.home.appsTitle}</h2></div><p class="lead" data-i18n="home.appsIntro">{copy.home.appsIntro}</p></div><div class="access-grid"><div class="access-card"><h3 data-i18n="home.appMarketplaceTitle">{copy.home.appMarketplaceTitle}</h3><p data-i18n="home.appMarketplaceBody">{copy.home.appMarketplaceBody}</p></div><div class="access-card"><h3 data-i18n="home.appMerchantTitle">{copy.home.appMerchantTitle}</h3><p data-i18n="home.appMerchantBody">{copy.home.appMerchantBody}</p><p class="channel-account">DR520</p></div></div></div></section>
  </main>
  <Footer /><Localizer />
</Layout>
