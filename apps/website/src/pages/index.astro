---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import Localizer from "../components/Localizer.astro";
import { EXTERNAL_LINKS } from "../constants";
import { locales } from "../i18n";
const copy = locales.zh;
const categories = copy.home.categories;
const ecosystem = copy.home.ecosystemNodes;
const chain = copy.home.chain.map((title, index) => [title, copy.home.chainBodies[index]]);
---
<Layout titleKey="home.title" descriptionKey="home.intro">
  <main>
    <section class="hero" id="top">
      <div class="hero-arc hero-arc--outer" aria-hidden="true"></div><div class="hero-arc hero-arc--gold" aria-hidden="true"></div><div class="hero-disc" aria-hidden="true"></div>
      <Header dark />
      <div class="hero-content"><p class="eyebrow eyebrow--line" data-i18n="home.eyebrow">{copy.home.eyebrow}</p><h1 data-i18n="home.title">{copy.home.title}</h1><p class="subtitle" data-i18n="home.subtitle">{copy.home.subtitle}</p><p class="hero-copy" data-i18n="home.intro">{copy.home.intro}</p><div class="button-row"><a class="button button--gold" href="/merchant" data-i18n="home.primary">{copy.home.primary}</a><a class="button" href="#vision" data-i18n="home.secondary">{copy.home.secondary} →</a></div></div>
      <div class="stats">{copy.home.stats.map(([number, label], index) => <div class="stat"><strong>{number}</strong><span data-i18n={`home.stats.${index}.1`}>{label}</span></div>)}</div>
    </section>
    <section class="section vision" id="vision"><div class="section-heading"><div><p class="eyebrow" data-i18n="home.visionLabel">{copy.home.visionLabel}</p><h2 class="section-title" data-i18n="home.visionTitle">{copy.home.visionTitle}</h2></div><p class="section-copy" data-i18n="home.visionIntro">{copy.home.visionIntro}</p></div><ol class="stages">{copy.home.stages.map(([number, status, title, body], index) => <li class="stage"><div><strong>{number}</strong><span class:list={["badge", { "badge--dark": index === 0 }]} data-i18n={`home.stages.${index}.1`}>{status}</span></div><h3 data-i18n={`home.stages.${index}.2`}>{title}</h3><p data-i18n={`home.stages.${index}.3`}>{body}</p></li>)}</ol></section>
    <section class="section section--dark" id="ecosystem"><div class="ecosystem"><div><p class="eyebrow" data-i18n="home.ecoLabel">{copy.home.ecoLabel}</p><h2 class="section-title" data-i18n="home.ecoTitle">{copy.home.ecoTitle}</h2><p class="section-copy" data-i18n="home.ecoIntro">{copy.home.ecoIntro}</p><p class="eco-legend"><span><i></i><span data-i18n="home.open">{copy.home.open}</span></span><span><i class="planned"></i><span data-i18n="home.planned">{copy.home.planned}</span></span></p></div><div class="ecosystem-orbit" role="img"><strong>DR.LIFE<span>+</span><small>PLATFORM</small></strong>{ecosystem.map(([title, body, state], index) => <div class:list={["ecosystem-node", `ecosystem-node--${index}`, { "ecosystem-node--planned": state === "planned" }]}><b data-i18n={`home.ecosystemNodes.${index}.0`}>{title}</b><span data-i18n={`home.ecosystemNodes.${index}.1`}>{body}</span></div>)}</div></div></section>
    <section class="section categories"><div class="section-heading"><div><p class="eyebrow" data-i18n="home.categoriesLabel">{copy.home.categoriesLabel}</p><h2 class="section-title" data-i18n="home.categoriesTitle">{copy.home.categoriesTitle}</h2></div><a class="text-link" href={EXTERNAL_LINKS.buyerBot} data-i18n="home.categoriesCta">{copy.home.categoriesCta}</a></div><div class="category-grid">{categories.map(([english, title, note], index) => <div class:list={["category-card", `category-card--${index}`]}><span data-i18n={`home.categories.${index}.0`}>{english}</span><h3 data-i18n={`home.categories.${index}.1`}>{title}</h3><small data-i18n={`home.categories.${index}.2`}>{note}</small></div>)}</div></section>
    <section class="section section--light" id="service"><div class="section-heading"><div><p class="eyebrow" data-i18n="home.chainLabel">{copy.home.chainLabel}</p><h2 class="section-title" data-i18n="home.chainTitle">{copy.home.chainTitle}</h2></div><p class="section-copy" data-i18n="home.chainIntro">{copy.home.chainIntro}</p></div><ol class="chain">{chain.map(([title, body], index) => <li class:list={["chain-step", { "chain-step--highlight": index === 4 }]}><span>STEP 0{index + 1}</span><strong data-i18n={`home.chain.${index}`}>{title}</strong><small data-i18n={`home.chainBodies.${index}`}>{body}</small></li>)}</ol><p class="section-copy chain-note" data-i18n="home.chainNote">{copy.home.chainNote}</p></section>
    <section class="section" id="about"><p class="eyebrow" data-i18n="home.partnersLabel">{copy.home.partnersLabel}</p><h2 class="section-title" data-i18n="home.partnersTitle">{copy.home.partnersTitle}</h2><div class="partners">{copy.home.partners.map(([title, body], index) => <article class="partner"><span>0{index + 1}</span><h3 data-i18n={`home.partners.${index}.0`}>{title}</h3><p data-i18n={`home.partners.${index}.1`}>{body}</p><a href={index === 0 ? "/merchant" : "/contact"} data-i18n={`home.partnerCtas.${index}`}>{copy.home.partnerCtas[index]}</a></article>)}</div></section>
  </main><Footer /><Localizer />
</Layout>
