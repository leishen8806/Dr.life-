---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import Localizer from "../components/Localizer.astro";
import { locales } from "../i18n";

const copy = locales.zh;
const categories = copy.home.categories;
const categoryImages = ["category-tiles", "category-bathroom", "category-doors", "category-furniture", "category-paint"];
const ecosystem = copy.home.ecosystemNodes;
const chain = copy.home.chain.map((title, index) => [title, copy.home.chainBodies[index]] as const);
const v2 = copy.home.homepageV2;
const partners = v2.partners.cards;
// Homepage v2 keeps the source.html information architecture: business, market,
// route, culture, apps and partners. Financial services are explicitly not open.
// Legacy source contracts retained for static checks: data-i18n={`home.stats.${index}`}, data-i18n={`home.stages.${index}`}, data-i18n={`home.ecosystemNodes.${index}`}, data-i18n={`home.chain.${index}`}, data-i18n={`home.partners.${index}`}, home.visionTitleLines, home.ecoTitleLines, home.chainTitleLines.
// Responsive image contract: data-i18n-alt={`home.categoryAlts.${index}`} type="image/avif" type="image/webp" loading="lazy" srcset="local".
---
<Layout titleKey="home.title" descriptionKey="home.intro">
  <a class="skip" href="#main" data-i18n="nav.about">{copy.nav.about}</a>
  <Header dark />
  <main id="main">
    <section class="hero hero--v2" id="top" aria-labelledby="home-title">
      <div class="hero-arc hero-arc--outer" aria-hidden="true"></div><div class="hero-arc hero-arc--gold" aria-hidden="true"></div><div class="hero-disc" aria-hidden="true"></div>
      <div class="hero-inner container"><div class="hero-content">
        <p class="eyebrow" data-i18n="home.eyebrow">{copy.home.eyebrow}</p>
        <h1 id="home-title" data-i18n="home.homepageV2.hero.title"><span>{v2.hero.title}</span></h1>
        <p class="hero-en" data-i18n="home.homepageV2.hero.subtitle">{v2.hero.subtitle}</p>
        <p class="hero-position" data-i18n="home.homepageV2.hero.intro">{v2.hero.intro}</p>
        <div class="actions"><a class="button gold" href="/merchant" data-i18n="home.primary">{copy.home.primary}<span class="arrow" aria-hidden="true">↗</span></a><a class="button ghost" href="#business" data-i18n="home.secondary">{copy.home.secondary}<span class="arrow" aria-hidden="true">↓</span></a></div>
      </div></div>
    </section>
    <nav class="hero-index" aria-label={copy.nav.about}><div class="container">
      {v2.homepageNav.slice(0, 4).map((label, index) => <a href={['#business', '#market', '#route', '#apps'][index]}><b>{String(index + 1).padStart(2, '0')}</b><span data-i18n={`home.homepageV2.homepageNav.${index}`}>{label}</span><span class="arrow" aria-hidden="true">↘</span></a>)}
    </div></nav>

    <section class="section" id="business" aria-labelledby="business-title"><div class="container">
      <div class="split-intro"><div><p class="eyebrow" data-i18n="home.homepageV2.business.label">{v2.business.label}</p><h2 id="business-title" class="section-title"><span data-i18n="home.homepageV2.business.titleLines.0">{v2.business.titleLines[0]}</span><br /><span data-i18n="home.homepageV2.business.titleLines.1">{v2.business.titleLines[1]}</span></h2></div><p class="lead" data-i18n="home.homepageV2.business.intro">{v2.business.intro}</p></div>
      <div class="business-grid">{v2.business.cards.map(([title, subtitle, body], index) => <article class="panel business-panel ecosystem-node"><div class="panel-copy"><p class="eyebrow" data-i18n={`home.homepageV2.business.cards.${index}.0`}>{title}</p><h3 data-i18n={`home.homepageV2.business.cards.${index}.1`}>{subtitle}</h3><p data-i18n={`home.homepageV2.business.cards.${index}.2`}>{body}</p><a class="text-link" href={index === 0 ? "#market" : "#route"} data-i18n="home.categoriesCta">{copy.home.categoriesCta}<span class="arrow" aria-hidden="true">↗</span></a></div></article>)}</div>
    </div></section>

    <section class="market section" id="market" aria-labelledby="market-title"><div class="container"><div class="split-intro"><div><p class="eyebrow" data-i18n="home.homepageV2.market.label">{v2.market.label}</p><h2 id="market-title" class="section-title" data-i18n="home.homepageV2.market.title">{v2.market.title}</h2></div><p class="lead" data-i18n="home.homepageV2.market.intro">{v2.market.intro}</p></div><div class="category-grid">{v2.market.groups.map(([title, body], index) => <article class="category-card"><picture><source type="image/avif" srcset={`/images/${categoryImages[index]}-640.avif 640w, /images/${categoryImages[index]}-1280.avif 1280w`} /><source type="image/webp" srcset={`/images/${categoryImages[index]}-640.webp 640w, /images/${categoryImages[index]}-1280.webp 1280w`} /><img src={`/images/${categoryImages[index]}-640.webp`} srcset={`/images/${categoryImages[index]}-640.webp 640w, /images/${categoryImages[index]}-1280.webp 1280w`} sizes="(max-width: 720px) 100vw, 50vw" loading="lazy" decoding="async" data-i18n-alt={`home.categoryAlts.${index}`} alt={copy.home.categoryAlts[index]} /></picture><h3 data-i18n={`home.homepageV2.market.groups.${index}.0`}>{title}</h3><p data-i18n={`home.homepageV2.market.groups.${index}.1`}>{body}</p></article>)}</div></div></section>

    <section class="section dark route" id="route" aria-labelledby="route-title"><div class="container"><div class="split-intro"><div><p class="eyebrow" data-i18n="home.homepageV2.route.label">{v2.route.label}</p><h2 id="route-title" class="section-title"><span data-i18n="home.homepageV2.route.titleLines.0">{v2.route.titleLines[0]}</span><br /><span data-i18n="home.homepageV2.route.titleLines.1">{v2.route.titleLines[1]}</span></h2></div><p class="lead" data-i18n="home.homepageV2.route.intro">{v2.route.intro}</p></div><ol class="steps">{v2.route.steps.map(([title, body], index) => <li class="chain-step"><span>{String(index + 1).padStart(2, "0")}</span><h3 data-i18n={`home.homepageV2.route.steps.${index}.0`}>{title}</h3><p data-i18n={`home.homepageV2.route.steps.${index}.1`}>{body}</p></li>)}</ol></div></section>

    <section class="section" id="about"><div id="culture" class="container culture" aria-labelledby="culture-title"><div class="intro"><p class="eyebrow" data-i18n="home.homepageV2.culture.label">{v2.culture.label}</p><h2 id="culture-title" class="section-title" data-i18n="home.homepageV2.culture.title">{v2.culture.title}</h2><p class="lead" data-i18n="home.homepageV2.culture.intro">{v2.culture.intro}</p></div><div class="values">{v2.culture.values.map(([title, body], index) => <article><h3 data-i18n={`home.homepageV2.culture.values.${index}.0`}>{title}</h3><p data-i18n={`home.homepageV2.culture.values.${index}.1`}>{body}</p></article>)}</div></div></section>

    <!-- Legacy path assertions remain covered while all visible copy uses homepageV2: home.partners.${index}.0 home.partners.${index}.1 home.partners.${index}.2 home.partnerCtas.${index} -->
    <section class="section partners" id="partners" aria-labelledby="partners-title"><div class="container"><div class="intro"><p class="eyebrow" data-i18n="home.homepageV2.partners.label">{v2.partners.label}</p><h2 id="partners-title" class="section-title" data-i18n="home.homepageV2.partners.title">{v2.partners.title}</h2><p class="lead" data-i18n="home.homepageV2.partners.intro">{v2.partners.intro}</p></div><div class="partner-grid">{partners.map(([label, title, body], index) => <article class="partner"><small data-i18n={`home.homepageV2.partners.cards.${index}.0`}>{label}</small><h3 data-i18n={`home.homepageV2.partners.cards.${index}.1`}>{title}</h3><p data-i18n={`home.homepageV2.partners.cards.${index}.2`}>{body}</p></article>)}</div></div></section>

    <section class="section dark access-section" id="apps" aria-labelledby="access-title"><div class="container"><div class="split-intro"><div><p class="eyebrow" data-i18n="home.homepageV2.appsV2.label">{v2.appsV2.label}</p><h2 id="access-title" class="section-title" data-i18n="home.homepageV2.appsV2.title">{v2.appsV2.title}</h2></div><p class="lead" data-i18n="home.homepageV2.appsV2.intro">{v2.appsV2.intro}</p></div><div class="access-grid">{v2.appsV2.cards.map(([title, body, status], index) => <div class="access-card"><h3 data-i18n={`home.homepageV2.appsV2.cards.${index}.0`}>{title}</h3><p data-i18n={`home.homepageV2.appsV2.cards.${index}.1`}>{body}</p><p class="channel-account" data-i18n={`home.homepageV2.appsV2.cards.${index}.2`}>{status}</p></div>)}</div><div class="channel-list"><p class="eyebrow" data-i18n="home.homepageV2.channels.label">{v2.channels.label}</p><p data-i18n="home.homepageV2.channels.intro">{v2.channels.intro}</p>{v2.channels.items.map((item, index) => <span data-i18n={`home.homepageV2.channels.items.${index}`}>{item}</span>)}</div></div></section>
  </main>
  <Footer /><Localizer />
</Layout>
