---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import Localizer from "../components/Localizer.astro";
import { locales } from "../i18n";

const copy = locales.zh;
const categories = copy.home.categories;
const categoryImages = ["category-tiles", "category-bathroom", "category-doors", "category-furniture", "category-paint"];
const ecosystem = copy.home.ecosystemNodes;
const chain = copy.home.chain.map((title, index) => [title, copy.home.chainBodies[index]] as const);
const partners = copy.home.partners;
const v2 = copy.home.homepageV2;
// Homepage v2 keeps the source.html information architecture: business, market,
// route, culture, apps and partners. Financial services are explicitly not open.
// home.ecoTitleLines remains a legacy locale key for compatibility; visible copy uses dedicated about keys.
---
<Layout titleKey="home.title" descriptionKey="home.intro">
  <a class="skip" href="#main" data-i18n="nav.about">{copy.nav.about}</a>
  <Header dark />
  <main id="main">
    <section class="hero hero--v2" id="top" aria-labelledby="home-title">
      <div class="hero-arc hero-arc--outer" aria-hidden="true"></div><div class="hero-arc hero-arc--gold" aria-hidden="true"></div><div class="hero-disc" aria-hidden="true"></div>
      <div class="hero-inner container"><div class="hero-content">
        <p class="eyebrow" data-i18n="home.eyebrow">{copy.home.eyebrow}</p>
        <h1 id="home-title" data-i18n="home.title"><span>{copy.home.title}</span></h1>
        <p class="hero-en" data-i18n="home.subtitle">{copy.home.subtitle}</p>
        <p class="hero-position" data-i18n="home.intro">{copy.home.intro}</p>
        <div class="actions"><a class="button gold" href="/merchant" data-i18n="home.primary">{copy.home.primary}<span class="arrow" aria-hidden="true">↗</span></a><a class="button ghost" href="#business" data-i18n="home.secondary">{copy.home.secondary}<span class="arrow" aria-hidden="true">↓</span></a></div>
      </div></div>
    </section>
    <nav class="hero-index" aria-label={copy.nav.about}><div class="container">
      {v2.homepageNav.slice(0, 4).map((label, index) => <a href={['#business', '#market', '#route', '#apps'][index]}><b>{String(index + 1).padStart(2, '0')}</b><span>{label}</span><span class="arrow" aria-hidden="true">↘</span></a>)}
    </div></nav>

    <section class="section" id="business" aria-labelledby="business-title"><div class="container">
      <div class="split-intro"><div><p class="eyebrow">{v2.business.label}</p><h2 id="business-title" class="section-title"><span>{v2.business.titleLines[0]}</span><br /><span>{v2.business.titleLines[1]}</span></h2></div><p class="lead">{v2.business.intro}</p></div>
      <div class="business-grid">{v2.business.cards.map(([title, subtitle, body], index) => <article class="panel business-panel ecosystem-node"><div class="panel-copy"><p class="eyebrow">{title}</p><h3>{subtitle}</h3><p>{body}</p><a class="text-link" href={index === 0 ? "#market" : "#route"}>{index === 0 ? "了解详情 ↗" : "准备合作资料 ↗"}</a></div></article>)}</div>
    </div></section>

    <section class="market section" id="market" aria-labelledby="market-title"><div class="container"><div class="split-intro"><div><p class="eyebrow">{v2.market.label}</p><h2 id="market-title" class="section-title">{v2.market.title}</h2></div><p class="lead">{v2.market.intro}</p></div><div class="category-grid">{v2.market.groups.map(([title, body]) => <article class="category-card"><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>

    <section class="section dark route" id="route" aria-labelledby="route-title"><div class="container"><div class="split-intro"><div><p class="eyebrow">{v2.route.label}</p><h2 id="route-title" class="section-title"><span>{v2.route.titleLines[0]}</span><br /><span>{v2.route.titleLines[1]}</span></h2></div><p class="lead">{v2.route.intro}</p></div><ol class="steps">{v2.route.steps.map(([title, body], index) => <li class="chain-step"><span>{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{body}</p></li>)}</ol></div></section>

    <section class="section" id="about"><div id="culture" class="container culture" aria-labelledby="culture-title"><div class="intro"><p class="eyebrow">{v2.culture.label}</p><h2 id="culture-title" class="section-title">{v2.culture.title}</h2><p class="lead">{v2.culture.intro}</p></div><div class="values">{v2.culture.values.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>

    <section class="section partners" id="partners" aria-labelledby="partners-title"><div class="container"><div class="intro"><p class="eyebrow" data-i18n="home.partnersLabel">{copy.home.partnersLabel}</p><h2 id="partners-title" class="section-title" data-i18n="home.partnersTitle">{copy.home.partnersTitle}</h2></div><div class="partner-grid">{partners.map(([label, title, body], index) => <article class="partner"><small data-i18n={`home.partners.${index}.0`}>{label}</small><h3 data-i18n={`home.partners.${index}.1`}>{title}</h3><p data-i18n={`home.partners.${index}.2`}>{body}</p><a class="text-link" href={index === 0 ? "/merchant" : "/contact"} data-i18n={`home.partnerCtas.${index}`}>{copy.home.partnerCtas[index]}<span class="arrow" aria-hidden="true">↗</span></a></article>)}</div></div></section>

    <section class="section dark access-section" id="apps" aria-labelledby="access-title"><div class="container"><div class="split-intro"><div><p class="eyebrow">{v2.appsV2.label}</p><h2 id="access-title" class="section-title">{v2.appsV2.title}</h2></div><p class="lead">{v2.appsV2.intro}</p></div><div class="access-grid">{v2.appsV2.cards.map(([title, body, status]) => <div class="access-card"><h3>{title}</h3><p>{body}</p><p class="channel-account">{status}</p></div>)}</div></div></section>
  </main>
  <Footer /><Localizer />
</Layout>
