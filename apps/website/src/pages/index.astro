---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import Localizer from "../components/Localizer.astro";
import { EXTERNAL_LINKS } from "../constants";
import { locales } from "../i18n";
const copy = locales.zh;
const categories = [
  ["TILES · FLOORING", "瓷砖与地板", "[场景大片]"], ["", "卫浴", ""], ["", "门窗", ""], ["", "家具", ""], ["", "涂料", ""]
];
const ecosystem = [
  ["线上商城", "Telegram 三语商城", "open"], ["本地仓配", "金边仓 · 出库配送", "open"], ["支付结算", "在线付款 · 签收后结算", "open"], ["生活服务", "规划中", "planned"], ["商家服务", "规划中", "planned"], ["跨境供应链", "中国 → 柬埔寨", "open"]
];
const chain = [["中国工厂", "对接厂家与供应商"], ["广州集货", "短期集货、合并装柜"], ["跨境清关", "路线按商品确认"], ["金边入仓", "分区上架，库存到库位"], ["DR.LIFE+ 销售", "三语商城，免佣金"], ["本地配送", "覆盖区与时效以订单确认为准"]];
---
<Layout titleKey="home.title" descriptionKey="home.intro">
  <main>
    <section class="hero" id="top">
      <div class="hero-arc hero-arc--outer" aria-hidden="true"></div><div class="hero-arc hero-arc--gold" aria-hidden="true"></div><div class="hero-disc" aria-hidden="true"></div>
      <Header dark />
      <div class="hero-content"><p class="eyebrow eyebrow--line" data-i18n="home.eyebrow">{copy.home.eyebrow}</p><h1 data-i18n="home.title">{copy.home.title}</h1><p class="subtitle" data-i18n="home.subtitle">{copy.home.subtitle}</p><p class="hero-copy" data-i18n="home.intro">{copy.home.intro}</p><div class="button-row"><a class="button button--gold" href="/merchant" data-i18n="home.primary">{copy.home.primary}</a><a class="button" href="#vision" data-i18n="home.secondary">{copy.home.secondary} →</a></div></div>
      <div class="stats">{copy.home.stats.map(([number, label], index) => <div class="stat"><strong>{number}</strong><span data-i18n={`home.stats.${index}.1`}>{label}</span></div>)}</div>
    </section>
    <section class="section vision" id="vision"><div class="section-heading"><div><p class="eyebrow" data-i18n="home.visionLabel">{copy.home.visionLabel}</p><h2 class="section-title" data-i18n="home.visionTitle">{copy.home.visionTitle}</h2></div><p class="section-copy" data-i18n="home.visionIntro">{copy.home.visionIntro}</p></div><ol class="stages">{copy.home.stages.map(([number, status, title, body], index) => <li class="stage"><div><strong>{number}</strong><span class:list={["badge", { "badge--dark": index === 0 }]} data-i18n={`home.stages.${index}.1`}>{status}</span></div><h3 data-i18n={`home.stages.${index}.2`}>{title}</h3><p data-i18n={`home.stages.${index}.3`}>{body}</p></li>)}</ol></section>
    <section class="section section--dark" id="ecosystem"><div class="ecosystem"><div><p class="eyebrow" data-i18n="home.ecoLabel">{copy.home.ecoLabel}</p><h2 class="section-title" data-i18n="home.ecoTitle">{copy.home.ecoTitle}</h2><p class="section-copy" data-i18n="home.ecoIntro">{copy.home.ecoIntro}</p><p class="eco-legend"><span><i></i><span data-i18n="home.open">{copy.home.open}</span></span><span><i class="planned"></i><span data-i18n="home.planned">{copy.home.planned}</span></span></p></div><div class="ecosystem-orbit" role="img" aria-label="DR.LIFE+ platform ecosystem"><strong>DR.LIFE<span>+</span><small>PLATFORM</small></strong>{ecosystem.map(([title, body, state], index) => <div class:list={["ecosystem-node", `ecosystem-node--${index}`, { "ecosystem-node--planned": state === "planned" }]}><b>{title}</b><span>{body}</span></div>)}</div></div></section>
    <section class="section categories"><div class="section-heading"><div><p class="eyebrow">WHERE WE START</p><h2 class="section-title">从建材家居开始</h2></div><a class="text-link" href={EXTERNAL_LINKS.buyerBot}>进入商城浏览全部商品 →</a></div><div class="category-grid">{categories.map(([english, title, note], index) => <div class:list={["category-card", `category-card--${index}`]}><span>{english}</span><h3>{title}</h3><small>{note}</small></div>)}</div></section>
    <section class="section section--light" id="service"><div class="section-heading"><div><p class="eyebrow" data-i18n="home.chainLabel">ONE-STOP · CHINA TO CAMBODIA</p><h2 class="section-title">从中国工厂，<br />到柬埔寨买家手中</h2></div><p class="section-copy">采购、集运、清关、仓储、销售、配送，一个平台对接。商家不必自建仓库，也不必分别对接多家服务商。</p></div><ol class="chain">{chain.map(([title, body], index) => <li class:list={["chain-step", { "chain-step--highlight": index === 4 }]}><span>STEP 0{index + 1}</span><strong>{title}</strong><small>{body}</small></li>)}</ol><p class="section-copy chain-note" data-i18n="home.chainNote">{copy.home.chainNote}</p></section>
    <section class="section" id="about"><p class="eyebrow">GROW WITH US</p><h2 class="section-title" data-i18n="home.partnersTitle">{copy.home.partnersTitle}</h2><div class="partners">{copy.home.partners.map(([title, body], index) => <article class="partner"><span>0{index + 1}</span><h3 data-i18n={`home.partners.${index}.0`}>{title}</h3><p data-i18n={`home.partners.${index}.1`}>{body}</p><a href={index === 0 ? "/merchant" : "/contact"}>了解更多 →</a></article>)}</div></section>
  </main><Footer /><Localizer />
</Layout>
