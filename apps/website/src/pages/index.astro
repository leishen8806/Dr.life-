---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import Localizer from "../components/Localizer.astro";
import { EXTERNAL_LINKS } from "../constants";
import { locales } from "../i18n";
const copy = locales.zh;
const categories = copy.home.categories;
const categoryImages = ["category-tiles", "category-bathroom", "category-doors", "category-furniture", "category-paint"];
const ecosystem = copy.home.ecosystemNodes;
const chain = copy.home.chain.map((title, index) => [title, copy.home.chainBodies[index]]);
---
<Layout titleKey="home.title" descriptionKey="home.intro">
  <main>
    <section class="hero" id="top">
      <div class="hero-arc hero-arc--outer" aria-hidden="true"></div><div class="hero-arc hero-arc--gold" aria-hidden="true"></div><div class="hero-disc" aria-hidden="true"></div>
      <Header dark />
      <div class="hero-content"><p class="eyebrow eyebrow--line" data-i18n="home.eyebrow">{copy.home.eyebrow}</p><h1 data-i18n="home.title">{copy.home.title}</h1><p class="subtitle" data-i18n="home.subtitle">{copy.home.subtitle}</p><p class="hero-copy" data-i18n="home.intro">{copy.home.intro}</p><div class="button-row"><a class="button button--gold" href="/merchant" data-i18n="home.primary">{copy.home.primary}</a><a class="button" href="#vision" data-i18n="home.secondary">{copy.home.secondary} →</a></div></div>
      <div class="stats">{copy.home.stats.map(([number, label], index) => <div class="stat"><strong>{number}</strong><span data-i18n={`home.stats.${index}.1`}>{label}</span></div>)}</div>
    </section>
    <section class="section vision" id="vision"><div class="section-heading"><div><p class="eyebrow" data-i18n="home.visionLabel">{copy.home.visionLabel}</p><h2 class="section-title"><span data-i18n="home.visionTitleLines.0">{copy.home.visionTitleLines[0]}</span><br /><span data-i18n="home.visionTitleLines.1">{copy.home.visionTitleLines[1]}</span></h2></div><p class="section-copy" data-i18n="home.visionIntro">{copy.home.visionIntro}</p></div><ol class="stages">{copy.home.stages.map(([number, status, title, body], index) => <li class="stage"><div><strong>{number}</strong><span class:list={["badge", { "badge--dark": index === 0 }]} data-i18n={`home.stages.${index}.1`}>{status}</span></div><h3 data-i18n={`home.stages.${index}.2`}>{title}</h3><p data-i18n={`home.stages.${index}.3`}>{body}</p></li>)}</ol></section>
    <section class="section section--dark" id="ecosystem"><div class="ecosystem"><div><p class="eyebrow" data-i18n="home.ecoLabel">{copy.home.ecoLabel}</p><h2 class="section-title"><span data-i18n="home.ecoTitleLines.0">{copy.home.ecoTitleLines[0]}</span><br /><span data-i18n="home.ecoTitleLines.1">{copy.home.ecoTitleLines[1]}</span></h2><p class="section-copy" data-i18n="home.ecoIntro">{copy.home.ecoIntro}</p><p class="eco-legend"><span><i></i><span data-i18n="home.open">{copy.home.open}</span></span><span><i class="planned"></i><span data-i18n="home.planned">{copy.home.planned}</span></span></p></div><div class="ecosystem-orbit" role="img"><strong>DR.LIFE<span>+</span><small>PLATFORM</small></strong>{ecosystem.map(([title, body, state], index) => <div class:list={["ecosystem-node", `ecosystem-node--${index}`, { "ecosystem-node--planned": state === "planned" }]}><b data-i18n={`home.ecosystemNodes.${index}.0`}>{title}</b><span data-i18n={`home.ecosystemNodes.${index}.1`}>{body}</span></div>)}</div></div></section>
    <section class="section categories"><div class="section-heading"><div><p class="eyebrow" data-i18n="home.categoriesLabel">{copy.home.categoriesLabel}</p><h2 class="section-title" data-i18n="home.categoriesTitle">{copy.home.categoriesTitle}</h2></div><a class="text-link" href={EXTERNAL_LINKS.buyerBot} data-i18n="home.categoriesCta">{copy.home.categoriesCta}</a></div><div class="category-grid">{categories.map(([english, title, note], index) => <div class:list={["category-card", `category-card--${index}`]}><picture><source type="image/avif" srcset={`/images/${categoryImages[index]}-640.avif 640w, /images/${categoryImages[index]}-1280.avif 1280w`} sizes="(max-width: 520px) calc(100vw - 40px), (max-width: 900px) 100vw, min(50vw, 640px)" /><source type="image/webp" srcset={`/images/${categoryImages[index]}-640.webp 640w, /images/${categoryImages[index]}-1280.webp 1280w`} sizes="(max-width: 520px) calc(100vw - 40px), (max-width: 900px) 100vw, min(50vw, 640px)" /><img src={`/images/${categoryImages[index]}-640.webp`} width="640" height="520" loading="lazy" decoding="async" data-i18n-alt={`home.categoryAlts.${index}`} alt={copy.home.categoryAlts[index]} /></picture><span data-i18n={`home.categories.${index}.0`}>{english}</span><h3 data-i18n={`home.categories.${index}.1`}>{title}</h3><small data-i18n={`home.categories.${index}.2`}>{note}</small></div>)}</div></section>
    <section class="section section--light" id="service"><div class="section-heading"><div><p class="eyebrow" data-i18n="home.chainLabel">{copy.home.chainLabel}</p><h2 class="section-title"><span data-i18n="home.chainTitleLines.0">{copy.home.chainTitleLines[0]}</span><br /><span data-i18n="home.chainTitleLines.1">{copy.home.chainTitleLines[1]}</span></h2></div><p class="section-copy" data-i18n="home.chainIntro">{copy.home.chainIntro}</p></div><ol class="chain">{chain.map(([title, body], index) => <li class:list={["chain-step", { "chain-step--highlight": index === 4 }]}><span>STEP 0{index + 1}</span><strong data-i18n={`home.chain.${index}`}>{title}</strong><small data-i18n={`home.chainBodies.${index}`}>{body}</small></li>)}</ol><p class="section-copy chain-note" data-i18n="home.chainNote">{copy.home.chainNote}</p></section>
    <section class="section" id="about"><p class="eyebrow" data-i18n="home.partnersLabel">{copy.home.partnersLabel}</p><h2 class="section-title" data-i18n="home.partnersTitle">{copy.home.partnersTitle}</h2><div class="partners">{copy.home.partners.map(([label, title, body], index) => <article class="partner"><span data-i18n={`home.partners.${index}.0`}>{label}</span><h3 data-i18n={`home.partners.${index}.1`}>{title}</h3><p data-i18n={`home.partners.${index}.2`}>{body}</p><a href={index === 0 ? "/merchant" : "/contact"} data-i18n={`home.partnerCtas.${index}`}>{copy.home.partnerCtas[index]}</a></article>)}</div></section>
    <!-- homepage-v2 design source: business, market, route, culture and access bands -->
    <section class="design-v2 section" id="business" aria-labelledby="business-title"><div class="split-intro"><div><p class="eyebrow">OUR BUSINESSES / FOUR BUSINESS LINES</p><h2 id="business-title" class="section-title"><span data-i18n="home.visionTitleLines.0">{copy.home.visionTitleLines[0]}</span><br /><span data-i18n="home.visionTitleLines.1">{copy.home.visionTitleLines[1]}</span></h2></div><p class="lead" data-i18n="home.visionIntro">{copy.home.visionIntro}</p></div><div class="business-panels">{ecosystem.map(([title, body, state], index) => <article class="business-panel"><span class="panel-index">{String(index + 1).padStart(2, "0")}</span><div><p class="eyebrow">{state === "open" ? "OPEN / ACTIVE" : "PLANNED"}</p><h3 data-i18n={`home.ecosystemNodes.${index}.0`}>{title}</h3><p data-i18n={`home.ecosystemNodes.${index}.1`}>{body}</p><a class="text-link" href="#partners">Explore the service ↗</a></div></article>)}</div></section>
    <section class="market section" id="market" aria-labelledby="market-title"><div class="split-intro"><div><p class="eyebrow">DR SMART MATERIALS CITY / MATERIALS MARKET</p><h2 id="market-title" class="section-title" data-i18n="home.categoriesTitle">{copy.home.categoriesTitle}</h2></div><p class="lead" data-i18n="home.categoriesCta">{copy.home.categoriesCta}</p></div><div class="category-groups"><div class="category-group"><h3>Materials &amp; renovation</h3><div class="pills">{categories.slice(0, 3).map(([label]) => <span>{label}</span>)}</div></div><div class="category-group"><h3>Custom &amp; home</h3><div class="pills">{categories.slice(3, 4).map(([label]) => <span>{label}</span>)}</div></div><div class="category-group"><h3>Tools &amp; daily life</h3><div class="pills">{categories.slice(4).map(([label]) => <span>{label}</span>)}</div></div></div></section>
    <section class="section section--dark route" id="route" aria-labelledby="route-title"><div class="split-intro"><div><p class="eyebrow">ONE WAREHOUSE INTO CAMBODIA / CROSS-BORDER FLOW</p><h2 id="route-title" class="section-title"><span data-i18n="home.chainTitleLines.0">{copy.home.chainTitleLines[0]}</span><br /><span data-i18n="home.chainTitleLines.1">{copy.home.chainTitleLines[1]}</span></h2></div><p class="lead" data-i18n="home.chainIntro">{copy.home.chainIntro}</p></div><ol class="steps">{chain.slice(0, 4).map(([title, body], index) => <li><span>{String(index + 1).padStart(2, "0")}</span><h3 data-i18n={`home.chain.${index}`}>{title}</h3><p data-i18n={`home.chainBodies.${index}`}>{body}</p></li>)}</ol></section>
    <section class="section culture" id="culture" aria-labelledby="culture-title"><div class="intro"><p class="eyebrow">THE DR SPIRIT / CULTURE</p><h2 id="culture-title" class="section-title" data-i18n="home.partnersTitle">{copy.home.partnersTitle}</h2><p class="lead" data-i18n="home.ecoIntro">{copy.home.ecoIntro}</p></div><div class="values">{copy.home.partners.slice(0, 3).map(([label, title, body], index) => <article><span data-i18n={`home.partners.${index}.0`}>{label}</span><h3 data-i18n={`home.partners.${index}.1`}>{title}</h3><p data-i18n={`home.partners.${index}.2`}>{body}</p></article>)}</div></section>
    <section class="section partners" id="partners" aria-labelledby="partners-title"><div class="intro"><p class="eyebrow">WORK WITH DR / COOPERATION</p><h2 id="partners-title" class="section-title" data-i18n="home.partnersTitle">{copy.home.partnersTitle}</h2><p class="lead" data-i18n="home.partnersLabel">{copy.home.partnersLabel}</p></div><div class="partner-grid">{copy.home.partners.map(([label, title, body], index) => <article class="partner"><small data-i18n={`home.partners.${index}.0`}>{label}</small><h3 data-i18n={`home.partners.${index}.1`}>{title}</h3><p data-i18n={`home.partners.${index}.2`}>{body}</p><a class="text-link" href={index === 0 ? "/merchant" : "/contact"} data-i18n={`home.partnerCtas.${index}`}>{copy.home.partnerCtas[index]} ↗</a></article>)}</div></section>
    <section class="section section--dark access-section" id="apps" aria-labelledby="access-title"><div class="split-intro"><div><p class="eyebrow">DR APPS &amp; OFFICIAL CHANNELS / MOBILE</p><h2 id="access-title" class="section-title" data-i18n="home.title">{copy.home.title}</h2></div><p class="lead" data-i18n="home.subtitle">{copy.home.subtitle}</p></div><div class="access-grid"><div class="access-card"><h3>DR App</h3><span class="demo-tag">DEMO</span><p>Mobile services are being prepared.</p></div><div class="access-card"><h3>Official channels</h3><p>Contact the DR team through the official cooperation route.</p><a class="text-link" href="/contact">Contact DR ↗</a></div></div></section>
  </main><Footer /><Localizer />
</Layout>
