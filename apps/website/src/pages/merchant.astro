---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import Localizer from "../components/Localizer.astro";
import { EXTERNAL_LINKS } from "../constants";
import { locales } from "../i18n";
const copy = locales.zh;
---
<Layout titleKey="merchant.title" descriptionKey="merchant.intro">
  <Header />
  <main>
    <section class="merchant-hero">
      <div class="section">
        <p class="eyebrow" data-i18n="merchant.eyebrow">{copy.merchant.eyebrow}</p>
        <h1 class="section-title" data-i18n="merchant.title">{copy.merchant.title}</h1>
        <p class="hero-copy" data-i18n="merchant.intro">{copy.merchant.intro}</p>
        <div class="stats">
          <div class="stat"><strong>0%</strong><span data-i18n="merchant.fees.0.0">{copy.merchant.fees[0][0]}</span></div>
          <div class="stat"><strong>0</strong><span data-i18n="merchant.fees.1.0">{copy.merchant.fees[1][0]}</span></div>
        </div>
      </div>
    </section>
    <section class="section">
      <h2 class="section-title" data-i18n="merchant.stepsTitle">{copy.merchant.stepsTitle}</h2>
      <div class="steps">
        {copy.merchant.steps.map(([title, body], index) => <article class="step"><strong>0{index + 1}</strong><h3 data-i18n={`merchant.steps.${index}.0`}>{title}</h3><p data-i18n={`merchant.steps.${index}.1`}>{body}</p></article>)}
      </div>
    </section>
    <section class="section">
      <h2 class="section-title" data-i18n="merchant.feesTitle">{copy.merchant.feesTitle}</h2>
      <p class="section-copy" data-i18n="merchant.feesIntro">{copy.merchant.feesIntro}</p>
      <div class="fee-grid">
        {copy.merchant.fees.map(([title, fee, body], index) => <article class="fee"><h3 data-i18n={`merchant.fees.${index}.0`}>{title}</h3><strong data-i18n={`merchant.fees.${index}.1`}>{fee}</strong><p data-i18n={`merchant.fees.${index}.2`}>{body}</p></article>)}
      </div>
      <div class="button-row"><a class="button button--gold" href={EXTERNAL_LINKS.merchantBot} data-i18n="merchant.cta">{copy.merchant.cta}</a></div>
    </section>
  </main>
  <Footer />
  <Localizer />
</Layout>
