    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "jsdom": "29.1.1",
    "vite": "7.3.0"
  }
}
